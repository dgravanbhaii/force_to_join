async def approval_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query

    if not query:
        return

    if query.from_user.id != config.OWNER_ID:
        await query.answer(
            "❌ Owner only.",
            show_alert=True,
        )
        return

    await query.answer()

    data = query.data or ""

    if ":" not in data:
        return

    action, raw_user_id = data.split(":", 1)

    if not raw_user_id.isdigit():
        return

    target_user_id = int(raw_user_id)

    approvals = load_approvals()
    record = approvals.get(str(target_user_id))

    if not record:
        await query.edit_message_text(
            "⚠️ User record not found."
        )
        return

    if action == "approve":
        record["status"] = "approved"
        record["approved_by"] = config.OWNER_ID
        record["approved_at"] = datetime.now(
            timezone.utc
        ).isoformat()

        approvals[str(target_user_id)] = record
        save_approvals(approvals)

        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=(
                    "✅ <b>ACCESS APPROVED</b>\n\n"
                    "Your request has been approved by the owner."
                ),
                parse_mode="HTML",
            )
        except Exception:
            logger.exception(
                "Could not notify approved user %s",
                target_user_id,
            )

        username = record.get("username", "")
        username_text = (
            f"@{escape(username)}"
            if username
            else "None"
        )

        await query.edit_message_text(
            "✅ <b>USER APPROVED</b>\n\n"
            f"🆔 <b>User ID:</b> "
            f"<code>{target_user_id}</code>\n"
            f"👤 <b>Name:</b> "
            f"{escape(record.get('first_name', ''))}\n"
            f"🔹 <b>Username:</b> "
            f"{username_text}\n\n"
            "🟢 <b>Status:</b> Approved",
            parse_mode="HTML",
        )

        return

    if action == "reject":
        record["status"] = "rejected"
        record["rejected_by"] = config.OWNER_ID
        record["rejected_at"] = datetime.now(
            timezone.utc
        ).isoformat()

        approvals[str(target_user_id)] = record
        save_approvals(approvals)

        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=(
                    "❌ <b>ACCESS REJECTED</b>\n\n"
                    "Your request was rejected by the owner."
                ),
                parse_mode="HTML",
            )
        except Exception:
            logger.exception(
                "Could not notify rejected user %s",
                target_user_id,
            )

        username = record.get("username", "")
        username_text = (
            f"@{escape(username)}"
            if username
            else "None"
        )

        await query.edit_message_text(
            "❌ <b>USER REJECTED</b>\n\n"
            f"🆔 <b>User ID:</b> "
            f"<code>{target_user_id}</code>\n"
            f"👤 <b>Name:</b> "
            f"{escape(record.get('first_name', ''))}\n"
            f"🔹 <b>Username:</b> "
            f"{username_text}\n\n"
            "🔴 <b>Status:</b> Rejected",
            parse_mode="HTML",
        )


