# GROUP JOIN WELCOME
# ============================================================

async def member_update(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    event = update.chat_member

    if not event:
        return

    user = event.new_chat_member.user
    chat = event.chat

    old_status = event.old_chat_member.status
    new_status = event.new_chat_member.status

    member_statuses = {
        ChatMemberStatus.MEMBER,
        ChatMemberStatus.RESTRICTED,
        ChatMemberStatus.ADMINISTRATOR,
        ChatMemberStatus.OWNER,
    }

    # Only handle a transition into the group.
    if new_status not in member_statuses:
        return

    if old_status in member_statuses:
        return

    joined_at = getattr(
        event,
        "date",
        None,
    )

    if joined_at is None:
        joined_at = datetime.now(
            timezone.utc
        )

    group_count = record_group_join(
        user,
        chat,
        joined_at,
    )

    full_name = " ".join(
        part
        for part in (
            user.first_name,
            user.last_name,
        )
        if part
    ) or "Unknown"

    username = (
        f"@{user.username}"
        if user.username
        else "None"
    )

    language = (
        user.language_code
        if user.language_code
        else "Unknown"
    )

    joined_text = joined_at.astimezone().strftime(
        "%Y-%m-%d %H:%M:%S %Z"
    )

    welcome_text = (
        "🎉 <b>NEW MEMBER JOINED</b>\n\n"
        f"👤 <b>Username:</b> "
        f"{escape(username)}\n"
        f"🆔 <b>User ID:</b> "
        f"<code>{user.id}</code>\n"
        f"📅 <b>Date of Joining:</b> "
        f"{escape(joined_text)}\n"
        f"🌐 <b>Language:</b> "
        f"{escape(language)}\n"
        f"👥 <b>Groups Joined:</b> "
        f"{group_count}\n\n"
        f"🎊 Welcome, <b>{escape(full_name)}</b>!"
    )

    try:
        await context.bot.send_message(
            chat_id=chat.id,
            text=welcome_text,
            parse_mode="HTML",
        )
    except Exception:
        logger.exception(
            "Failed to send group welcome message"
        )

    logger.info(
        "Member joined | user=%s | group=%s | groups=%s",
        user.id,
        chat.id,
        group_count,
    )


