            "dg_assistant",
            api_id=config.API_ID,
            api_hash=config.API_HASH,
            session_string=config.SESSION_STRING,
        )

        await REPORT_ASSISTANT.start()

        me = await REPORT_ASSISTANT.get_me()

        logger.info(
            "Assistant connected | id=%s | username=@%s",
            me.id,
            me.username or "None",
        )

    except Exception:
        REPORT_ASSISTANT = None
        logger.exception(
            "Failed to start Telegram assistant"
        )


async def post_shutdown(application):
    global REPORT_ASSISTANT

    if REPORT_ASSISTANT is not None:
        try:
            await REPORT_ASSISTANT.stop()
            logger.info("Assistant stopped.")
        except Exception:
            logger.exception(
                "Failed to stop Telegram assistant"
            )

        REPORT_ASSISTANT = None


