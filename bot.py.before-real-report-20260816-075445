logger = logging.getLogger(__name__)

APPROVAL_FILE = Path("approvals.json")
GROUPS_FILE = Path("user_groups.json")


def load_approvals():
    if not APPROVAL_FILE.exists():
        return {}

    try:
        return json.loads(
            APPROVAL_FILE.read_text(encoding="utf-8")
        )
    except Exception:
        logger.exception("Failed to load approvals.json")
        return {}


def save_approvals(data):
    APPROVAL_FILE.write_text(
        json.dumps(data, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )


def get_user_status(user_id: int):
    data = load_approvals()
    return data.get(str(user_id), {}).get("status")


def save_user(user, status: str):
    data = load_approvals()
    user_id = str(user.id)

    record = data.get(user_id, {})

    record.update(
        {
            "user_id": user.id,
            "first_name": user.first_name or "",
            "last_name": user.last_name or "",
            "username": user.username or "",
            "language_code": user.language_code or "",
            "is_premium": bool(getattr(user, "is_premium", False)),
            "is_bot": bool(user.is_bot),
            "status": status,
            "updated_at": datetime.now(timezone.utc).isoformat(),
        }
    )

    data[user_id] = record
    save_approvals(data)


def approval_keyboard(user_id: int):
    return InlineKeyboardMarkup(
        [[
            InlineKeyboardButton(
                "✅ Approve",
                callback_data=f"approve:{user_id}",
            ),
            InlineKeyboardButton(
                "❌ Reject",
                callback_data=f"reject:{user_id}",
            ),
        ]]
    )


def format_user_info(user) -> str:
    full_name = " ".join(
        part
        for part in [user.first_name, user.last_name]
        if part
    ) or "Unknown"

    username = f"@{user.username}" if user.username else "None"
    language = user.language_code or "Unknown"
    premium = "Yes" if getattr(user, "is_premium", False) else "No"
    bot_account = "Yes" if user.is_bot else "No"

    return (
        "👤 <b>NEW USER REQUEST</b>\n\n"
        f"🆔 <b>User ID:</b> <code>{user.id}</code>\n"
        f"👤 <b>Name:</b> {escape(full_name)}\n"
        f"🔹 <b>Username:</b> {escape(username)}\n"
        f"🌐 <b>Language:</b> {escape(language)}\n"
        f"💎 <b>Premium:</b> {premium}\n"
        f"🤖 <b>Bot Account:</b> {bot_account}\n\n"
        "⏳ <b>Status:</b> Pending"
    )



def user_has_bot_access(user_id: int) -> bool:
    if user_id == config.OWNER_ID:
        return True

    return get_user_status(user_id) == "approved"


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    message = update.effective_message

    if not user or not message:
        return

    if user.id == config.OWNER_ID:
        await message.reply_text(
            "👑 <b>Welcome, Owner.</b>\n\n"
            "You have full access.\n\n"
            "Use:\n"
            "<code>/addmember USER_ID</code>",
            parse_mode="HTML",
        )
        return

    status = get_user_status(user.id)

    if status == "approved":
        await message.reply_text(
            "✅ <b>Access Approved</b>\n\n"
            "Your request was approved by the owner.",
            parse_mode="HTML",
        )
        return

    if status == "rejected":
        await message.reply_text(
            "❌ <b>Access Rejected</b>\n\n"
            "Your request was rejected by the owner.",
            parse_mode="HTML",
        )
        return

    save_user(user, "pending")

    try:
        await context.bot.send_message(
            chat_id=config.OWNER_ID,
            text=format_user_info(user),
            parse_mode="HTML",
            reply_markup=approval_keyboard(user.id),
        )

        await message.reply_text(
            "⏳ <b>Approval Required</b>\n\n"
            "Your request has been sent to the owner.\n"
            "Please wait for approval.",
            parse_mode="HTML",
        )

        logger.info(
            "Approval request sent | user=%s",
            user.id,
        )

    except Exception:
        logger.exception("Failed to send owner approval request")

        await message.reply_text(
            "⚠️ Could not submit your approval request."
        )


