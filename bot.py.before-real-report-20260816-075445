}


def parse_telegram_message_link(link: str):
    link = link.strip().rstrip("/")

    # Public:
    # https://t.me/username/123
    # https://telegram.me/username/123
    import re

    match = re.match(
        r"^https?://(?:t\.me|telegram\.me)/([A-Za-z0-9_]+)/(\d+)$",
        link,
    )

    if match:
        username = match.group(1)
        message_id = int(match.group(2))
        return username, message_id

    # Private/supergroup/channel internal link:
    # https://t.me/c/1234567890/123
    match = re.match(
        r"^https?://(?:t\.me|telegram\.me)/c/(\d+)/(\d+)$",
        link,
    )

    if match:
        internal_id = match.group(1)
        message_id = int(match.group(2))
        chat_id = int("-100" + internal_id)
        return chat_id, message_id

    return None, None


