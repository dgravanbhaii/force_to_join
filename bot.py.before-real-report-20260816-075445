async def addmember(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    user = update.effective_user
    message = update.effective_message

    if not user or not message:
        return

    # --------------------------------------------------------
    # OWNER OR APPROVED USER ONLY
    # --------------------------------------------------------

    if user.id != config.OWNER_ID:
        if get_user_status(user.id) != "approved":
            await message.reply_text(
                "❌ <b>Owner approval required.</b>\n\n"
                "You must be approved by the owner before using this feature.",
                parse_mode="HTML",
            )
            return

    # --------------------------------------------------------
    # TARGET USER
    # --------------------------------------------------------

    if not context.args:
        await message.reply_text(
            "❌ <b>User ID required.</b>\n\n"
            "Usage:\n"
            "<code>/addmember USER_ID</code>\n\n"
            "Example:\n"
            "<code>/addmember 8358364648</code>",
            parse_mode="HTML",
        )
        return

    target = context.args[0].strip()

    if not target.lstrip("-").isdigit():
        await message.reply_text(
            "❌ Invalid Telegram user ID."
        )
        return

    target_user_id = int(target)

    # --------------------------------------------------------
    # APPROVED USER = PAYMENT REQUIRED
    # OWNER = SKIP PAYMENT
    # --------------------------------------------------------

    if user.id != config.OWNER_ID:
        payment_keyboard = InlineKeyboardMarkup(
            [
                [
                    InlineKeyboardButton(
                        "💳 Pay ₹5",
                        callback_data=f"payment_placeholder:{target_user_id}",
                    )
                ]
            ]
        )

        await message.reply_text(
            "💳 <b>MEMBER ADD PAYMENT</b>\n\n"
            f"👤 <b>User ID:</b> <code>{target_user_id}</code>\n"
            "💰 <b>Amount:</b> ₹5\n\n"
            "Payment is required per member.",
            parse_mode="HTML",
            reply_markup=payment_keyboard,
        )
        return

    # --------------------------------------------------------
    # OWNER = DIRECT BOT INVITE
    # --------------------------------------------------------

    await message.reply_text(
        "🔄 <b>Creating group invite...</b>\n\n"
        f"👤 <b>User ID:</b> <code>{target_user_id}</code>",
        parse_mode="HTML",
    )

    # Check bot administrator status
    try:
        bot_user = await context.bot.get_me()

        bot_member = await context.bot.get_chat_member(
            chat_id=config.TARGET_GROUP_USERNAME,
            user_id=bot_user.id,
        )

        if bot_member.status not in (
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER,
        ):
            await message.reply_text(
                "❌ Bot is not an administrator in "
                f"{escape(config.TARGET_GROUP_USERNAME)}."
            )
            return

    except Exception as e:
        logger.exception("Failed to check bot group access")

        await message.reply_text(
            "❌ Could not access the target group.\n\n"
            f"<code>{escape(str(e))}</code>",
            parse_mode="HTML",
        )
        return

    # Create one-use invite
    try:
        invite = await context.bot.create_chat_invite_link(
            chat_id=config.TARGET_GROUP_USERNAME,
            member_limit=1,
        )

    except Exception as e:
        logger.exception("Invite creation failed")

        await message.reply_text(
            "❌ <b>Invite creation failed.</b>\n\n"
            "Make sure the bot is an administrator and has "
            "permission to invite users via links.\n\n"
            f"<code>{escape(str(e))}</code>",
            parse_mode="HTML",
        )
        return

    # Send invite to target user's DM
    try:
        await context.bot.send_message(
            chat_id=target_user_id,
            text=(
                "🎉 <b>GROUP INVITATION</b>\n\n"
                "You have been invited to join:\n"
                f"<b>{escape(config.TARGET_GROUP_USERNAME)}</b>\n\n"
                "🔗 <b>Join here:</b>\n"
                f"{invite.invite_link}\n\n"
                "⚠️ This invitation is limited to one member."
            ),
            parse_mode="HTML",
        )

    except Exception as e:
        logger.exception(
            "Failed to send invite DM | user=%s",
            target_user_id,
        )

        await message.reply_text(
            "⚠️ <b>Invite created, but DM failed.</b>\n\n"
            "The target user may need to start the bot first.\n\n"
            f"Telegram error:\n"
            f"<code>{escape(str(e))}</code>\n\n"
            "🔗 <b>Invite link:</b>\n"
            f"{invite.invite_link}",
            parse_mode="HTML",
        )
        return

    await message.reply_text(
        "✅ <b>Invite sent successfully!</b>\n\n"
        f"👤 User ID: <code>{target_user_id}</code>\n"
        f"🔗 {invite.invite_link}",
        parse_mode="HTML",
    )

    logger.info(
        "Owner addmember invite sent | target=%s",
        target_user_id,
    )


