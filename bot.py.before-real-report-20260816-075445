# GROUP TRACKING HELPERS
# ============================================================

def load_group_data():
    if not GROUPS_FILE.exists():
        return {}

    try:
        return json.loads(
            GROUPS_FILE.read_text(
                encoding="utf-8"
            )
        )
    except Exception:
        logger.exception(
            "Failed to read user_groups.json"
        )
        return {}


def save_group_data(data):
    GROUPS_FILE.write_text(
        json.dumps(
            data,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )


def record_group_join(user, chat, joined_at):
    data = load_group_data()

    user_key = str(user.id)
    group_key = str(chat.id)

    groups = data.setdefault(
        user_key,
        {}
    )

    groups[group_key] = {
        "group_id": chat.id,
        "group_title": (
            getattr(chat, "title", None)
            or getattr(chat, "username", None)
            or str(chat.id)
        ),
        "joined_at": joined_at.isoformat(),
    }

    save_group_data(data)

    return len(groups)


def get_group_join_count(user_id: int) -> int:
    data = load_group_data()

    return len(
        data.get(
            str(user_id),
            {}
        )
    )


