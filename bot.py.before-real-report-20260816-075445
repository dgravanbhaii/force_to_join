    # --------------------------------------------------------

    if not context.args:
        await message.reply_text(
            "❌ <b>Public channel username required.</b>\n\n"
            "Usage:\n"
            "<code>/channelintel @channelusername</code>\n\n"
            "Example:\n"
            "<code>/channelintel @example</code>",
            parse_mode="HTML",
        )
        return

    channel = context.args[0].strip()

    if not channel.startswith("@"):
        channel = "@" + channel

    await message.reply_text(
        "🔎 <b>Analyzing public channel...</b>\n\n"
        f"🔗 {escape(channel)}",
        parse_mode="HTML",
    )

    # --------------------------------------------------------
    # ASSISTANT CLIENT
    # --------------------------------------------------------

    try:
        from pyrogram import Client

        assistant = Client(
            "dg_channel_intel",
            api_id=config.API_ID,
            api_hash=config.API_HASH,
            session_string=config.SESSION_STRING,
        )

        async with assistant:

            chat = await assistant.get_chat(
                channel
            )

            # Public channel requirement
            if not chat.username:
                await message.reply_text(
                    "🔒 <b>Private Channel</b>\n\n"
                    "This command currently supports public channels only.",
                    parse_mode="HTML",
                )
                return

            # ------------------------------------------------
            # BASIC CHANNEL INFORMATION
            # ------------------------------------------------

            title = (
                chat.title
                or "Unknown"
            )

            username = (
                f"@{chat.username}"
                if chat.username
                else "None"
            )

            channel_id = chat.id

            subscribers = getattr(
                chat,
                "members_count",
                None,
            )

            description = getattr(
                chat,
                "description",
                None,
            )

            verified = (
                "Yes"
                if getattr(
                    chat,
                    "is_verified",
                    False,
                )
                else "No"
            )

            scam_flag = (
                "Yes"
                if getattr(
                    chat,
                    "is_scam",
                    False,
                )
                else "No"
            )

            fake_flag = (
                "Yes"
                if getattr(
                    chat,
                    "is_fake",
                    False,
                )
                else "No"
            )

            # ------------------------------------------------
            # LINKED DISCUSSION GROUP
            # ------------------------------------------------

            linked_chat = getattr(
                chat,
                "linked_chat",
                None,
            )

            discussion_lines = []

            if linked_chat:
                discussion_lines.append(
                    "✅ <b>Discussion Group:</b> Linked"
                )
                discussion_lines.append(
                    f"💬 <b>Discussion:</b> "
                    f"{escape(linked_chat.title or 'Unknown')}"
                )
                discussion_lines.append(
                    f"🆔 <b>Discussion ID:</b> "
                    f"<code>{linked_chat.id}</code>"
                )

            else:
                discussion_lines.append(
                    "❌ <b>Discussion Group:</b> Not linked"
                )

            # ------------------------------------------------
            # RECENT PUBLIC COMMENTERS
            # ------------------------------------------------

            commenters = {}

            if linked_chat:
                try:
                    async for msg in assistant.get_chat_history(
                        linked_chat.id,
                        limit=100,
                    ):
                        sender = getattr(
                            msg,
                            "from_user",
                            None,
                        )

                        if not sender:
                            continue

                        if sender.is_bot:
                            continue

                        sender_id = sender.id

                        full_name = " ".join(
                            part
                            for part in (
                                sender.first_name,
                                sender.last_name,
                            )
                            if part
                        ) or "Unknown"

                        commenters[sender_id] = {
                            "id": sender_id,
                            "username": sender.username,
                            "name": full_name,
                            "date": msg.date,
                        }

                        if len(commenters) >= 10:
                            break

                except Exception as e:
                    logger.warning(
                        "Could not inspect discussion group: %s",
                        e,
                    )

            # ------------------------------------------------
            # BUILD REPORT
            # ------------------------------------------------

            lines = [
                "🔎 <b>PUBLIC CHANNEL INTELLIGENCE</b>",
                "",
                f"📛 <b>Name:</b> {escape(title)}",
                f"🔗 <b>Username:</b> {escape(username)}",
                f"🆔 <b>Channel ID:</b> "
                f"<code>{channel_id}</code>",
            ]

            if subscribers is not None:
                lines.append(
                    f"👥 <b>Subscribers:</b> {subscribers}"
                )

            lines.extend(
                [
                    f"✅ <b>Verified:</b> {verified}",
                    f"⚠️ <b>Scam Flag:</b> {scam_flag}",
                    f"⚠️ <b>Fake Flag:</b> {fake_flag}",
                ]
            )

            if description:
                clean_description = (
                    description[:600]
                    + ("..." if len(description) > 600 else "")
                )

                lines.extend(
                    [
                        "",
                        "📝 <b>Description:</b>",
                        escape(clean_description),
                    ]
                )

            lines.extend(
                [
                    "",
                    "💬 <b>DISCUSSION</b>",
                    *discussion_lines,
                ]
            )

            lines.extend(
                [
                    "",
                    "👤 <b>RECENT PUBLIC COMMENTERS</b>",
                ]
            )

            if commenters:
                for item in list(
                    commenters.values()
                ):
                    if item["username"]:
                        identity = (
                            f"@{escape(item['username'])}"
                        )
                    else:
                        identity = escape(
                            item["name"]
                        )

                    lines.append(
                        f"• {identity} "
                        f"<code>{item['id']}</code>"
                    )
            else:
                lines.append(
                    "• No publicly visible commenters "
                    "were retrieved."
                )

            lines.extend(
                [
                    "",
                    "ℹ️ <i>This report contains publicly "
                    "available information only.</i>",
                    "🔒 <i>Hidden/anonymous administrators "
                    "are not identified.</i>",
                ]
            )

            await message.reply_text(
                "\n".join(lines),
                parse_mode="HTML",
            )

            logger.info(
                "Channel intelligence completed | channel=%s | requester=%s",
                channel,
                user.id,
            )

    except Exception as e:
        logger.exception(
            "Channel intelligence failed"
        )

        await message.reply_text(
            "❌ <b>Channel intelligence failed.</b>\n\n"
            f"<code>{escape(str(e))}</code>",
            parse_mode="HTML",
        )


