        status = get_user_status(user.id)

        if status == "pending":
            text = (
                "⏳ <b>Approval Pending</b>\n\n"
                "Please wait for the owner to approve your access."
            )
        elif status == "rejected":
            text = (
                "❌ <b>Access Rejected</b>\n\n"
                "You cannot use this feature."
            )
        else:
            text = (
                "🔐 <b>Approval Required</b>\n\n"
                "Send /start to request access."
            )

        await message.reply_text(
            text,
