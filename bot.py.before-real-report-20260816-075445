async def report_reason_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    query = update.callback_query

    if not query:
        return

    user = query.from_user

    if not user_has_bot_access(user.id):
        await query.answer(
            "❌ Approval required.",
            show_alert=True,
        )
        return

    await query.answer()

    data = query.data or ""

    if not data.startswith("reportreason:"):
        return

    reason_key = data.split(":", 1)[1]

    if reason_key not in REPORT_REASONS:
        await query.edit_message_text(
            "❌ Invalid report reason."
        )
        return

    peer = context.user_data.get(
        "report_peer"
    )

    message_id = context.user_data.get(
        "report_message_id"
    )

    report_link = context.user_data.get(
        "report_link"
    )

    if peer is None or message_id is None:
        await query.edit_message_text(
            "❌ Report session expired.\n\n"
            "Please use /report again."
        )
        return

    reason_name = REPORT_REASONS[reason_key]

    # Save selected reason for the next step.
    context.user_data["report_reason"] = reason_key

    report_method_keyboard = InlineKeyboardMarkup(
        [
            [
                InlineKeyboardButton(
                    "🚨 Telegram API Report",
                    callback_data="reportmethod:telegram",
                )
            ],
            [
                InlineKeyboardButton(
                    "📧 Email Report (Placeholder)",
                    callback_data="email_report:placeholder",
                )
            ],
        ]
    )

    await query.edit_message_text(
        "🚨 <b>REPORT METHOD</b>\n\n"
        f"📌 <b>Reason:</b> {escape(reason_name)}\n\n"
        "Choose how you want to continue:",
        parse_mode="HTML",
        reply_markup=report_method_keyboard,
    )

    return

    try:
        from pyrogram import Client
        from pyrogram.raw.functions.messages import Report
        from pyrogram.raw.types import (
            InputReportReasonSpam,
            InputReportReasonViolence,
            InputReportReasonPornography,
            InputReportReasonChildAbuse,
            InputReportReasonIllegalDrugs,
            InputReportReasonFake,
            InputReportReasonPersonalDetails,
            InputReportReasonOther,
        )

        reason_classes = {
            "spam": InputReportReasonSpam,
            "violence": InputReportReasonViolence,
            "pornography": InputReportReasonPornography,
            "child_abuse": InputReportReasonChildAbuse,
            "illegal_drugs": InputReportReasonIllegalDrugs,
            "fake": InputReportReasonFake,
            "personal_details": InputReportReasonPersonalDetails,
            "other": InputReportReasonOther,
        }

        global REPORT_ASSISTANT

        if REPORT_ASSISTANT is None:
            await query.edit_message_text(
                "❌ <b>Telegram assistant is not connected.</b>\n\n"
                "Please try again after the bot finishes connecting.",
                parse_mode="HTML",
            )
            return

        assistant = REPORT_ASSISTANT

        resolved_peer = await assistant.resolve_peer(
            peer
        )

        result = await assistant.invoke(
            Report(
                peer=resolved_peer,
                id=[int(message_id)],
                reason=reason_classes[reason_key](),
                message=(
                    f"Reported via Telegram moderation tool. "
                    f"Reason: {reason_name}."
                ),
            )
        )

        logger.info(
            "Telegram report submitted | requester=%s | link=%s | reason=%s | result=%s",
            user.id,
            report_link,
            reason_key,
            result,
        )

        await query.edit_message_text(
            "✅ <b>REPORT SUBMITTED</b>\n\n"
            f"📌 <b>Reason:</b> {reason_name}\n"
            f"🔗 <b>Message:</b>\n{escape(report_link)}\n\n"
            "Telegram has received the report for review.",
            parse_mode="HTML",
        )

    except Exception as e:
        logger.exception(
            "Telegram report failed"
        )

        await query.edit_message_text(
            "❌ <b>REPORT FAILED</b>\n\n"
            f"<code>{escape(str(e))}</code>",
            parse_mode="HTML",
        )

    finally:
        context.user_data.pop(
            "report_peer",
            None,
        )
        context.user_data.pop(
            "report_message_id",
            None,
        )
        context.user_data.pop(
            "report_link",
            None,
        )


async def post_init(application):
