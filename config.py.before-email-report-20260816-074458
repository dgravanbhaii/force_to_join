import os
from dotenv import load_dotenv

load_dotenv()

BOT_TOKEN = os.getenv("BOT_TOKEN", "").strip()
OWNER_ID = int(os.getenv("OWNER_ID", "0"))

TARGET_GROUP_USERNAME = os.getenv(
    "TARGET_GROUP_USERNAME",
    ""
).strip()

API_ID = int(os.getenv("API_ID", "0"))
API_HASH = os.getenv("API_HASH", "").strip()
SESSION_STRING = os.getenv("SESSION_STRING", "").strip()

if not BOT_TOKEN:
    raise RuntimeError("BOT_TOKEN is missing in .env")

if not OWNER_ID:
    raise RuntimeError("OWNER_ID is missing in .env")

if not TARGET_GROUP_USERNAME:
    raise RuntimeError(
        "TARGET_GROUP_USERNAME is missing in .env"
    )

if not API_ID:
    raise RuntimeError("API_ID is missing in .env")

if not API_HASH:
    raise RuntimeError("API_HASH is missing in .env")

if not SESSION_STRING:
    raise RuntimeError("SESSION_STRING is missing in .env")
